# 在 Docker Hub 上构建 ultralytics/ultralytics:latest-nvidia-arm64 镜像：https://hub.docker.com/r/ultralytics/ultralytics
# 支持在 Jetson AGX Thor（T5000）和 DGX Spark 的 JetPack 7.0 及 DGX OS 上运行 YOLO

# Start FROM PyTorch image nvcr.io/nvidia/pytorch:25.10-py3
FROM nvcr.io/nvidia/pytorch:25.10-py3

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    UV_BREAK_SYSTEM_PACKAGES=1

# 下载到用户配置目录
ADD https://github.com/ultralytics/assets/releases/download/v0.0.0/Arial.ttf \
    https://github.com/ultralytics/assets/releases/download/v0.0.0/Arial.Unicode.ttf \
    /root/.config/Ultralytics/

# 安装 Linux 软件包
RUN apt-get update && \
    apt-get install -y --no-install-recommends libgl1 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 创建工作目录
WORKDIR /ultralytics

# 复制内容并配置依赖项
COPY . .
RUN sed -i'' -e 's/"opencv-python/"opencv-python-headless/' pyproject.toml
ADD https://github.com/ultralytics/assets/releases/download/v8.4.0/yolo26n.pt .

# 安装 pip 软件包（基础镜像中已安装 uv）
RUN uv pip install --system \
    https://github.com/ultralytics/assets/releases/download/v0.0.0/onnxruntime_gpu-1.24.0-cp312-cp312-linux_aarch64.whl && \
    # 重新安装 torch 和 torchvision，以确保兼容 CUDA 13.0
    uv pip install --system --force-reinstall torch torchvision --index-url https://download.pytorch.org/whl/cu130 && \
    uv pip install --system -e ".[export]" && \
    # 删除多余的构建文件
    rm -rf *.whl /root/.config/Ultralytics/persistent_cache.json

# Usage --------------------------------------------------------------------------------------------------------------

# Production builds: https://github.com/ultralytics/ultralytics/blob/main/.github/workflows/docker.yml
# Example (build): t=ultralytics/ultralytics:latest-nvidia-arm64 && docker build --platform linux/arm64 -f docker/Dockerfile-nvidia-arm64 -t $t .
# Example (push): docker push $t
# Example (pull): t=ultralytics/ultralytics:latest-nvidia-arm64 && docker pull $t
# Example (run-dgx-spark): docker run -it --ipc=host --device nvidia.com/gpu=all $t
# Example (run-dgx-spark-with-volume): docker run -it --ipc=host --device nvidia.com/gpu=all -v "$PWD/shared/datasets:/datasets" $t
# Example (run-jetson-thor): docker run -it --ipc=host --runtime=nvidia $t
# Example (run-jetson-thor-with-volume): docker run -it --ipc=host --runtime=nvidia -v "$PWD/shared/datasets:/datasets" $t
# CDI requires Docker >= 28.2.0 and nvidia-container-toolkit >= 1.18.
# Legacy --gpus all can lose GPU access after host systemd daemon reloads (nvidia-container-toolkit#48).
