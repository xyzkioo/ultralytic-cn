# 在 Docker Hub 上构建 ultralytics/ultralytics:latest-export 镜像：https://hub.docker.com/r/ultralytics/ultralytics
# ultralytics/ultralytics:latest 的导出优化版本，用于测试和基准评测
# 包含所有导出格式依赖及预安装的导出软件包

FROM ultralytics/ultralytics:latest

# 安装导出依赖
# TensorFlow 导出兼容性需要 Numpy 1.26.4
# onnxruntime-gpu 固定为 <1.27.0，因为 1.27.0 放弃了 CUDA 12 支持并提供 CUDA 13 二进制文件（基础镜像为 CUDA 12.8）
# 注意：tensorrt 按需安装，因为它取决于运行环境的 CUDA 版本
RUN uv pip install --system --no-cache -e ".[export]" numpy==1.26.4 && \
    uv pip install --system --no-cache "onnxruntime-gpu<1.27.0" paddlepaddle x2paddle numpy==1.26.4 && \
    rm -rf tmp ~/.cache /root/.config/Ultralytics/persistent_cache.json

# Usage --------------------------------------------------------------------------------------------------------------

# Production builds: https://github.com/ultralytics/ultralytics/blob/main/.github/workflows/docker.yml
# Example (build): t=ultralytics/ultralytics:latest-export && docker build -f docker/Dockerfile-export -t $t .
# Example (push): docker push $t
# Example (pull): t=ultralytics/ultralytics:latest-export && docker pull $t
# Example (run): docker run -it --ipc=host --device nvidia.com/gpu=all $t
# Example (run-with-volume): docker run -it --ipc=host --device nvidia.com/gpu=all -v "$PWD/shared/datasets:/datasets" $t
# CDI requires Docker >= 28.2.0 and nvidia-container-toolkit >= 1.18.
# Legacy --gpus all can lose GPU access after host systemd daemon reloads (nvidia-container-toolkit#48).
