# 在 Docker Hub 上构建 ultralytics/ultralytics:latest-python-export 镜像：https://hub.docker.com/r/ultralytics/ultralytics
# 具备完整导出能力的 YOLO 模型转换镜像

# 基于轻量级 Ultralytics Python 镜像构建
FROM ultralytics/ultralytics:latest-python

# 安装导出专用的系统软件包
# 安装 Edge TPU 需要 gnupg
# Sony IMX 导出需要 Java 运行时环境（default-jre-headless）
RUN apt-get update && \
    apt-get install -y --no-install-recommends gnupg default-jre-headless && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 安装导出依赖
RUN uv pip install --system --no-cache -e ".[export]" \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    --index-strategy unsafe-best-match && \
    uv pip install --system --no-cache paddlepaddle x2paddle && \
    rm -rf tmp ~/.cache /root/.config/Ultralytics/persistent_cache.json

# Usage --------------------------------------------------------------------------------------------------------------

